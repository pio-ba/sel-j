<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Selenium Suite" parallel="false" thread-count="1">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>
    <test name="Login Tests">
        <classes>
            <class name="com.selj.tests.LoginTest"/>
        </classes>
    </test>
    <test name="Products Tests">
        <classes>
            <class name="com.selj.tests.ProductsTest"/>
        </classes>
    </test>
    <test name="Basket Tests">
        <classes>
            <class name="com.selj.tests.BasketTest"/>
        </classes>
    </test>
</suite>
